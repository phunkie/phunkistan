declare(strict_types=1);

// Composer's bin proxy names the autoloader of the project that installed us,
// and it is asked first because it is the only one that is right in every case.
// __DIR__ resolves through a symlink, so a path repository installed with
// symlink: true would otherwise find this package's own vendor rather than the
// project's, and check the sources of whatever happens to be sitting next door.
$candidates = [
    $GLOBALS['_composer_autoload_path'] ?? null,
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($candidates as $autoload) {
    if ($autoload !== null && file_exists($autoload)) {
        require $autoload;
        break;
    }
}

use PhpParser\ParserFactory;
use Phunkie\Stan\Check\ArityCheck;
use Phunkie\Stan\Check\ScopeCheck;
use Phunkie\Stan\Check\SyntaxCheck;
use Phunkie\Stan\Cli\Application;
use Phunkie\Stan\Source\OpeningTag;

// In order, because a source that does not read is not worth asking questions
// about: the scope check would report names the grammar never understood.
$checks = [
    new SyntaxCheck((new ParserFactory())->createForNewestSupportedVersion(), new OpeningTag()),
    new ScopeCheck(),
    new ArityCheck(),
];

exit((new Application($checks))->run(array_slice($argv, 1)));
